<?xml version="1.0" encoding="utf-8"?>
<!--
  Storyteller is self-hosted and frequently served over plain HTTP on a LAN
  (e.g. http://192.168.1.10:8001), so cleartext must be allowed for
  user-entered hosts. The onboarding UI warns users when they connect over HTTP.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
